# Deployment URLs must be reachable by the indicated caller.
INVOIFY_PUBLIC_URL=https://quotes.example.com
TWENTY_PUBLIC_URL=https://crm.example.com
# Twenty route URL reachable from the editor server
TWENTY_CALLBACK_URL=https://crm.example.com/s/invoify/finalize-quote
# Generate a random 32+ character secret and use the same value in the Twenty app.
INVOIFY_HANDOFF_SECRET=
INVOIFY_SESSION_STORAGE_DIR=/var/lib/invoify/sessions
INVOIFY_COMPANY_PROFILE_PATH=/etc/invoify/company.json
INVOIFY_NUMBER_PREFIX=Q
# Highest existing number for the current financial year on first deployment
INVOIFY_NUMBER_START=0
# Use this only when supplying your own browser outside the provided image.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
